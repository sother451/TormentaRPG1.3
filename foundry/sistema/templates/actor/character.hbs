<div class="t13">
  <header class="t13-topo">
    <img src="{{ator.img}}" data-action="editImage" data-edit="img" alt="{{ator.name}}">
    <div class="t13-identidade">
      <input type="text" class="t13-nome" name="name" value="{{ator.name}}" placeholder="Nome do personagem">
      <p>Nível {{sys.nivel}} · BBA +{{sys.bba}}
        {{#each classes}} · {{this.name}} {{this.system.nivel}}{{/each}}
        {{#each racas}} · {{this.name}}{{/each}}</p>
    </div>
    <div class="t13-vida">
      <label>PV
        <span class="par"><input type="number" name="system.pv.value" value="{{fonte.pv.value}}"> / {{sys.pv.max}}</span>
      </label>
      <div class="t13-barra" role="presentation"><div style="width: {{pvPercentual}}%"></div></div>
      <label>PV temporários <input type="number" name="system.pv.temporario" value="{{fonte.pv.temporario}}" min="0"></label>
      <label>Pontos de Ação
        <span class="par"><input type="number" name="system.pa.value" value="{{fonte.pa.value}}" min="0"> <button type="button" class="t13-pa" data-action="gastarPA" title="Gastar 1 Ponto de Ação">Gastar</button></span>
      </label>
    </div>
  </header>

  <nav class="t13-abas">
    {{#each abas}}<button type="button" class="{{#if ativa}}ativa{{/if}}" data-action="mudarAba" data-aba="{{id}}">{{label}}</button>{{/each}}
  </nav>

  <section class="t13-corpo">

  {{#if (eq aba "geral")}}
    <div class="t13-habilidades">
      {{#each habilidades}}
      <div class="t13-hab">
        <button type="button" class="t13-mod" data-action="rolar" data-tipo="habilidade" data-id="{{id}}" title="Rolar teste de {{label}}">{{#if (gt mod 0)}}+{{/if}}{{mod}}</button>
        <strong>{{label}}</strong>
        <label>Valor <input type="number" name="system.habilidades.{{id}}.valor" value="{{valor}}" min="0"></label>
        <label>Outros <input type="number" name="system.habilidades.{{id}}.outros" value="{{outros}}"></label>
        <label>Temp. <input type="number" name="system.habilidades.{{id}}.temp" value="{{temp}}"></label>
      </div>
      {{/each}}
    </div>

    <div class="t13-numeros">
      <div><span>CA</span><strong>{{sys.ca}}</strong></div>
      <div><span>CD</span><strong>{{sys.cd}}</strong></div>
      <div><span>Iniciativa</span><strong>{{#if (gt sys.iniciativa -1)}}+{{/if}}{{sys.iniciativa}}</strong></div>
      <div><span>Corpo a corpo</span><strong>{{#if (gt sys.ataque.corpo -1)}}+{{/if}}{{sys.ataque.corpo}}</strong></div>
      <div><span>À distância</span><strong>{{#if (gt sys.ataque.distancia -1)}}+{{/if}}{{sys.ataque.distancia}}</strong></div>
      <div><span>Toque</span><strong>{{#if (gt sys.ataque.toque -1)}}+{{/if}}{{sys.ataque.toque}}</strong></div>
    </div>

    <div class="t13-duas">
      <div>
        <h3>Resistências</h3>
        {{#each resistencias}}
        <div class="t13-linha">
          <button type="button" class="t13-rolar" data-action="rolar" data-tipo="resistencia" data-id="{{id}}">{{label}}</button>
          <strong>{{#if (gt total -1)}}+{{/if}}{{total}}</strong>
          <select name="system.resistencias.{{id}}.habilidade">{{selectOptions ../escolhasHab selected=habilidade valueAttr="id" labelAttr="abrev"}}</select>
          <input type="number" name="system.resistencias.{{id}}.outros" value="{{outros}}" title="Outros">
          <input type="number" name="system.resistencias.{{id}}.temp" value="{{temp}}" title="Temporário">
        </div>
        {{/each}}
      </div>
      <div>
        <h3>Conjuração e tamanho</h3>
        <label class="t13-campo">Modificador de conjuração
          <select name="system.conjuracao.habilidade">{{selectOptions escolhasHab selected=fonte.conjuracao.habilidade valueAttr="id" labelAttr="abrev"}}</select>
        </label>
        <label class="t13-campo">Tamanho
          <select name="system.tamanho">{{selectOptions tamanhos selected=fonte.tamanho valueAttr="id" labelAttr="label"}}</select>
        </label>
        <label class="t13-campo">Tendência <input type="text" name="system.detalhes.tendencia" value="{{fonte.detalhes.tendencia}}"></label>
        <label class="t13-campo">Divindade <input type="text" name="system.detalhes.divindade" value="{{fonte.detalhes.divindade}}"></label>
      </div>
    </div>

    <h3>Classes e raça
      <span class="t13-acoes"><button type="button" data-action="criarItem" data-tipo="classe">Classe</button><button type="button" data-action="criarItem" data-tipo="raca">Raça</button></span>
    </h3>
    {{#each classes}}
    <div class="t13-linha t13-item">
      <img src="{{this.img}}" alt="">
      <a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      <label>Nível <input type="number" data-item-id="{{this.id}}" data-item-campo="system.nivel" value="{{this.system.nivel}}" min="0" max="20"></label>
      {{#if (ne this.system.pm.base null)}}<label>PM <input type="number" data-item-id="{{this.id}}" data-item-campo="system.pm.atual" value="{{this.system.pm.atual}}" min="0"></label>{{/if}}
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    {{#each racas}}
    <div class="t13-linha t13-item">
      <img src="{{this.img}}" alt=""><a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    {{#if sys.reservasPM.length}}
    <p class="t13-dica">Reservas de PM: {{#each sys.reservasPM}}{{this.nome}} {{this.atual}}/{{this.max}}{{#unless @last}} · {{/unless}}{{/each}}</p>
    {{/if}}
  {{/if}}

  {{#if (eq aba "pericias")}}
    <p class="t13-dica">Treinada = nível + 3; não treinada = metade do nível. Penalidade de armadura atual: {{sys.penalidadeArmadura}}.</p>
    <div class="t13-tabela">
      {{#each pericias}}
      <div class="t13-linha {{#unless utilizavel}}inativa{{/unless}}">
        <input type="checkbox" name="system.pericias.{{id}}.treinada" {{checked treinada}} title="Treinada">
        <button type="button" class="t13-rolar" data-action="rolar" data-tipo="pericia" data-id="{{id}}">{{label}}{{#if soTreinada}} *{{/if}}{{#if armadura}} ‡{{/if}}</button>
        <strong>{{#if (gt total -1)}}+{{/if}}{{total}}</strong>
        <select name="system.pericias.{{id}}.habilidade">{{selectOptions ../escolhasHab selected=habilidade valueAttr="id" labelAttr="abrev"}}</select>
        <input type="number" name="system.pericias.{{id}}.outros" value="{{outros}}" title="Outros">
      </div>
      {{/each}}
    </div>
    <p class="t13-dica">* só treinada · ‡ sofre penalidade de armadura</p>

    <h3>Especializações <span class="t13-acoes"><button type="button" data-action="adicionarEspecialidade">Nova</button></span></h3>
    {{#each especialidades}}
    <div class="t13-linha">
      <input type="checkbox" name="system.especialidades.{{chave}}.treinada" {{checked treinada}} title="Treinada">
      <button type="button" class="t13-rolar" data-action="rolar" data-tipo="especialidade" data-id="{{chave}}">{{nome}}</button>
      <strong>{{#if (gt total -1)}}+{{/if}}{{total}}</strong>
      <select name="system.especialidades.{{chave}}.habilidade">{{selectOptions ../escolhasHab selected=habilidade valueAttr="id" labelAttr="abrev"}}</select>
      <input type="number" name="system.especialidades.{{chave}}.outros" value="{{outros}}" title="Outros">
      <button type="button" data-action="removerEspecialidade" data-chave="{{chave}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
  {{/if}}

  {{#if (eq aba "combate")}}
    <h3>Armas <span class="t13-acoes"><button type="button" data-action="criarItem" data-tipo="arma">Nova arma</button></span></h3>
    {{#each armas}}
    <div class="t13-linha t13-item">
      <img src="{{item.img}}" alt="">
      <a data-action="editarItem" data-item-id="{{item.id}}">{{item.name}}</a>
      <span class="t13-info">ataque {{#if (gt ataque -1)}}+{{/if}}{{ataque}} · {{item.system.dano}}{{#if (gt dano -1)}}+{{/if}}{{dano}} · {{item.system.critico}}</span>
      {{#if (ne item.system.municao null)}}<label>Munição <input type="number" data-item-id="{{item.id}}" data-item-campo="system.municao" value="{{item.system.municao}}" min="0"></label>{{/if}}
      <button type="button" data-action="rolarArma" data-item-id="{{item.id}}">Atacar</button>
      <button type="button" data-action="excluirItem" data-item-id="{{item.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}

    <h3>Armaduras e escudos <span class="t13-acoes"><button type="button" data-action="criarItem" data-tipo="armadura">Nova</button></span></h3>
    {{#each armaduras}}
    <div class="t13-linha t13-item">
      <input type="checkbox" data-item-id="{{this.id}}" data-item-campo="system.equipada" {{checked this.system.equipada}} title="Equipada">
      <a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      <span class="t13-info">CA +{{this.system.ca}}{{#if this.system.escudo}} (escudo){{/if}} · penalidade {{this.system.penalidade}}</span>
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
  {{/if}}

  {{#if (eq aba "magias")}}
    <p class="t13-dica">CD das magias: {{sys.cd}} · modificador de conjuração {{sys.mdc}}</p>
    <p class="t13-filtro"><input type="search" data-filtro-magias placeholder="Filtrar magias por nome..."> <span class="t13-acoes"><button type="button" data-action="criarItem" data-tipo="magia">Nova magia</button></span></p>
    {{#each magiasPorCiclo}}
    <h3>{{ciclo}}º ciclo</h3>
    {{#each magias}}
    <div class="t13-linha t13-item" data-nome-magia="{{this.name}}">
      <input type="checkbox" data-item-id="{{this.id}}" data-item-campo="system.preparada" {{checked this.system.preparada}} title="Preparada">
      <a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      <span class="t13-info">{{this.system.custoPM}} PM</span>
      <button type="button" data-action="usarMagia" data-item-id="{{this.id}}">Lançar</button>
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    {{/each}}
  {{/if}}

  {{#if (eq aba "talentos")}}
    <p><span class="t13-acoes"><button type="button" data-action="criarItem" data-tipo="talento">Novo talento</button></span></p>
    {{#each talentos}}
    <div class="t13-linha t13-item">
      <a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      {{#if this.system.usos.max}}<label>Usos <input type="number" data-item-id="{{this.id}}" data-item-campo="system.usos.atual" value="{{this.system.usos.atual}}" min="0"> / {{this.system.usos.max}}</label>{{/if}}
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
  {{/if}}

  {{#if (eq aba "inventario")}}
    <p class="t13-dica">Carga: {{sys.carga.atual}} kg de {{sys.carga.limite}} kg (3 × Força).</p>
    <div class="t13-moedas">
      <label>T$ <input type="number" name="system.moedas.tibar" value="{{fonte.moedas.tibar}}" min="0"></label>
      <label>TP <input type="number" name="system.moedas.prata" value="{{fonte.moedas.prata}}" min="0"></label>
      <label>TO <input type="number" name="system.moedas.ouro" value="{{fonte.moedas.ouro}}" min="0"></label>
      <label>TL <input type="number" name="system.moedas.platina" value="{{fonte.moedas.platina}}" min="0"></label>
    </div>
    <p><span class="t13-acoes"><button type="button" data-action="criarItem" data-tipo="equipamento">Novo item</button><button type="button" data-action="criarItem" data-tipo="itemMagico">Novo item mágico</button></span></p>
    {{#each equipamentos}}
    <div class="t13-linha t13-item">
      <a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      <label>Qtd <input type="number" data-item-id="{{this.id}}" data-item-campo="system.quantidade" value="{{this.system.quantidade}}" min="0"></label>
      <span class="t13-info">{{this.system.peso}} kg</span>
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
    {{#each itensMagicos}}
    <div class="t13-linha t13-item">
      <input type="checkbox" data-item-id="{{this.id}}" data-item-campo="system.equipado" {{checked this.system.equipado}} title="Equipado">
      <a data-action="editarItem" data-item-id="{{this.id}}">{{this.name}}</a>
      <span class="t13-info">{{this.system.peso}} kg</span>
      <button type="button" data-action="excluirItem" data-item-id="{{this.id}}" title="Excluir"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}
  {{/if}}

  {{#if (eq aba "ajustes")}}
    <h3>Variáveis <span class="t13-acoes"><button type="button" data-action="adicionarVariavel">Nova variável</button></span></h3>
    <p class="t13-dica">Cada variável vira @nome e pode ser usada em qualquer fórmula (bônus das armas, dano das magias).</p>
    {{#each variaveis}}
    <div class="t13-linha">
      <code>@{{chave}}</code>
      <input type="text" name="system.variaveis.{{chave}}.nome" value="{{nome}}" title="Rótulo">
      <input type="text" name="system.variaveis.{{chave}}.valor" value="{{valor}}" title="Valor">
      <button type="button" data-action="removerVariavel" data-chave="{{chave}}" title="Remover"><i class="fa-solid fa-trash"></i></button>
    </div>
    {{/each}}

    <h3>Bônus gerais</h3>
    <p class="t13-dica">Somados automaticamente aos cálculos. Active Effects também podem alterar estes campos (system.bonus.*).</p>
    <div class="t13-bonus">
      <label>Ataque corpo a corpo <input type="number" name="system.bonus.ataqueCorpo" value="{{fonte.bonus.ataqueCorpo}}"></label>
      <label>Ataque à distância <input type="number" name="system.bonus.ataqueDistancia" value="{{fonte.bonus.ataqueDistancia}}"></label>
      <label>Ataque de toque <input type="number" name="system.bonus.ataqueToque" value="{{fonte.bonus.ataqueToque}}"></label>
      <label>Dano corpo a corpo <input type="number" name="system.bonus.danoCorpo" value="{{fonte.bonus.danoCorpo}}"></label>
      <label>Dano à distância <input type="number" name="system.bonus.danoDistancia" value="{{fonte.bonus.danoDistancia}}"></label>
      <label>Dano de magia <input type="number" name="system.bonus.danoMagia" value="{{fonte.bonus.danoMagia}}"></label>
      <label>CA <input type="number" name="system.bonus.ca" value="{{fonte.bonus.ca}}"></label>
      <label>CD <input type="number" name="system.bonus.cd" value="{{fonte.bonus.cd}}"></label>
      <label>Resistências <input type="number" name="system.bonus.resistencias" value="{{fonte.bonus.resistencias}}"></label>
      <label>Perícias (todas) <input type="number" name="system.bonus.pericias" value="{{fonte.bonus.pericias}}"></label>
      <label>PV (fixo) <input type="number" name="system.bonus.pv" value="{{fonte.bonus.pv}}"></label>
      <label>PV por nível <input type="number" name="system.bonus.pvNivel" value="{{fonte.bonus.pvNivel}}"></label>
      <label>PM (por reserva) <input type="number" name="system.bonus.pm" value="{{fonte.bonus.pm}}"></label>
    </div>
  {{/if}}

  {{#if (eq aba "biografia")}}
    {{formInput ator.system.schema.fields.biografia name="system.biografia" value=fonte.biografia enriched=enriquecido.biografia toggled=true}}
  {{/if}}

  </section>
</div>
