---
import '../styles/global.css';
import { navigation } from '../data/navigation';

interface Props {
  title: string;
  description?: string;
  activePath?: string;
}

const {
  title,
  description = 'Compêndio das regras comunitárias de Tormenta RPG 1.3.',
  activePath = ''
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const navigationRows = [
  navigation.slice(0, 5),
  navigation.slice(5, 10)
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16110f" />
    <title>{title} · Tormenta RPG 1.3</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={href('/')} aria-label="Tormenta RPG 1.3 — início">
          <span class="brand-mark">T</span>
          <span>
            <strong>Tormenta RPG 1.3</strong>
            <small>Compêndio SugarVerse</small>
          </span>
        </a>
        <nav class="top-nav" aria-label="Navegação principal">
          {navigationRows.map((row) => (
            <div class="top-nav-row">
              {row.map((item) => (
                <a
                  href={href(item.href)}
                  class:list={[activePath === item.href && 'is-active']}
                >{item.label}</a>
              ))}
            </div>
          ))}
        </nav>
      </div>
    </header>

    <main class="shell page-shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <p>Tormenta RPG 1.3 · compêndio comunitário em construção.</p>
        <a href={href('/sobre/')}>Sobre o projeto</a>
      </div>
    </footer>
  </body>
</html>
