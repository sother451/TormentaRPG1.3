---
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
interface Props { current: string; }
const { current } = Astro.props;
---
<div class="breadcrumbs equipment-breadcrumbs">
  <a href={href('/equipamentos/')}>Equipamentos</a> / {current}
</div>
