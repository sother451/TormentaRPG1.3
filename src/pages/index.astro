---
import BaseLayout from '../layouts/BaseLayout.astro';
import { navigation } from '../data/navigation';
import { classEntries } from '../data/classes';

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const sections = navigation.filter((item) => item.href !== '/');
---
<BaseLayout title="Início" activePath="/">
  <section class="hero-panel">
    <p class="eyebrow">Regras comunitárias</p>
    <h1>Tormenta RPG 1.3</h1>
    <p class="lede">Um compêndio navegável para consultar rapidamente as regras do projeto SugarVerse: personagem, raças, perícias, combate, equipamentos, classes, talentos, magias e condições.</p>
    <div class="hero-actions">
      <a class="button primary" href={href('/classes/')}>Explorar classes</a>
      <a class="button" href={href('/talentos/')}>Ver talentos gerais</a>
    </div>
  </section>

  <section class="stats" aria-label="Escopo já mapeado">
    <div class="stat"><strong>40</strong><span>raças mapeadas</span></div>
    <div class="stat"><strong>20</strong><span>perícias</span></div>
    <div class="stat"><strong>342</strong><span>talentos gerais</span></div>
    <div class="stat"><strong>{classEntries.length}</strong><span>classes e variantes</span></div>
  </section>

  <div class="section-heading">
    <div>
      <p class="eyebrow">Navegação</p>
      <h2>Compêndio</h2>
    </div>
  </div>

  <section class="card-grid">
    {sections.map((item) => (
      <a class="content-card" href={href(item.href)}>
        <h2>{item.label}</h2>
        <p>Abra a seção de {item.label.toLowerCase()} do Tormenta 1.3.</p>
      </a>
    ))}
  </section>
</BaseLayout>
