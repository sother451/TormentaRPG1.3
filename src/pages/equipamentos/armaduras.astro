---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EquipmentBack from '../../components/EquipmentBack.astro';
import '../../styles/equipment.css';
import { armorRules, armorProperties, armors, specialMaterials } from '../../data/equipamentos/armaduras';

const categories = [...new Set(armors.map((item) => item.category))];
const parsedMaterials = specialMaterials.map((material) => {
  const dot = material.description.indexOf('.');
  return {
    ...material,
    name: dot > 0 ? material.description.slice(0, dot) : 'Material',
    explanation: dot > 0 ? material.description.slice(dot + 1).trim() : material.description
  };
});
---
<BaseLayout title="Armaduras e Materiais" activePath="/equipamentos/">
  <EquipmentBack current="Armaduras, Escudos e Materiais" />
  <section class="section-hero">
    <p class="eyebrow">Equipamentos</p>
    <h1>Armaduras, Escudos e Materiais</h1>
    <p class="lede">Proteções e materiais especiais convertidos diretamente das planilhas do Tormenta 1.3.</p>
  </section>

  <nav class="local-nav" aria-label="Nesta página">
    <a href="#regras">Regras</a>
    <a href="#lista">Armaduras e Escudos</a>
    <a href="#materiais">Materiais Especiais</a>
  </nav>

  <section id="regras" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Uso de proteção</p><h2>Regras de Armaduras</h2></div></div>
    <div class="definition-list">
      {armorRules.map((rule) => <article><p>{rule}</p></article>)}
    </div>
    <div class="definition-list">
      {armorProperties.map((property) => <article><h3>{property.name}</h3><p>{property.text}</p></article>)}
    </div>
  </section>

  <section id="lista" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Consulta</p><h2>Armaduras e Escudos</h2></div></div>
    <section class="filter-panel armor-filter-panel">
      <label class="search-field"><span>Buscar</span><input id="armor-search" type="search" placeholder="Ex.: couro, cota, escudo..." /></label>
      <label class="select-field"><span>Categoria</span><select id="armor-category"><option value="all">Todas</option>{categories.map((c)=><option value={c}>{c}</option>)}</select></label>
      <p class="results-count"><strong id="armor-count">{armors.length}</strong> itens exibidos</p>
    </section>
    <div class="table-wrap">
      <table class="rules-table equipment-list-table">
        <thead><tr><th>Item</th><th>Categoria</th><th>Preço (TO)</th><th>CA</th><th>Des. Máx.</th><th>Penalidade</th><th>Peso</th></tr></thead>
        <tbody>
          {armors.map((item) => (
            <tr class="armor-row" data-search={item.name.toLowerCase()} data-category={item.category}>
              <td><strong>{item.name}</strong></td><td>{item.category}</td><td>{item.price}</td><td>{item.ca}</td><td>{item.maxDex}</td><td>{item.armorPenalty}</td><td>{item.weight}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty-state" id="armor-empty" hidden>Nenhuma armadura corresponde aos filtros atuais.</p>
  </section>

  <section id="materiais" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Construção especial</p><h2>Materiais Especiais</h2></div></div>
    <div class="table-wrap material-price-table-wrap">
      <table class="rules-table material-price-table">
        <thead>
          <tr>
            <th>Material</th>
            <th>Arma</th>
            <th>Armadura Leve</th>
            <th>Armadura Média</th>
            <th>Armadura Pesada</th>
            <th>Escudo Leve</th>
            <th>Escudo Pesado</th>
          </tr>
        </thead>
        <tbody>
          {parsedMaterials.map((material) => (
            <tr>
              <td><strong>{material.name}</strong></td>
              <td>{material.costs.weapon || '—'}</td>
              <td>{material.costs.lightArmor || '—'}</td>
              <td>{material.costs.mediumArmor || '—'}</td>
              <td>{material.costs.heavyArmor || '—'}</td>
              <td>{material.costs.lightShield || '—'}</td>
              <td>{material.costs.heavyShield || '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="material-grid material-explanations">
      {parsedMaterials.map((material) => (
        <article class="material-card">
          <h3>{material.name}</h3>
          <p>{material.explanation}</p>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const input=document.getElementById('armor-search');
      const category=document.getElementById('armor-category');
      const rows=[...document.querySelectorAll('.armor-row')];
      const count=document.getElementById('armor-count');
      const empty=document.getElementById('armor-empty');
      const normalize=(v)=>v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
      const apply=()=>{
        const q=normalize(input.value.trim()); let visible=0;
        rows.forEach((row)=>{
          const show=(!q||normalize(row.dataset.search||'').includes(q))&&(category.value==='all'||row.dataset.category===category.value);
          row.hidden=!show;if(show)visible++;
        });
        count.textContent=String(visible);empty.hidden=visible!==0;
      };
      input.addEventListener('input',apply);category.addEventListener('change',apply);
    })();
  </script>
</BaseLayout>
