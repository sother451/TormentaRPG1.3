---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/equipment.css';
import {
  weaponIntro, weaponTypes, weaponProperties, weaponSizeRules, weaponSizeTable,
  weapons, ammunition, technologicalWeapons, technologicalWarning
} from '../../data/equipamentos/armas';

const categories = [...new Set(weapons.map((weapon) => weapon.category))];
---
<BaseLayout title="Armas e Munições" activePath="/equipamentos/">
  <section class="section-hero">
    <p class="eyebrow">Equipamentos</p>
    <h1>Armas e Munições</h1>
    <p class="lede">Armas simples, marciais, exóticas, alquímicas e de cerco, com propriedades e estatísticas importadas da planilha do Tormenta 1.3.</p>
  </section>

  <nav class="local-nav" aria-label="Nesta página">
    <a href="#regras">Regras</a>
    <a href="#lista">Lista de Armas</a>
    <a href="#municoes">Munições</a>
    <a href="#tamanho">Tamanho</a>
    <a href="#tecnologicas">Tecnológicas</a>
  </nav>

  <section id="regras" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Uso</p><h2>Tipos e Propriedades</h2></div></div>
    {weaponIntro.map((p) => <div class="notice">{p}</div>)}
    <div class="two-column equipment-columns">
      <div class="definition-list one-column">
        {weaponTypes.map((item) => <article><h3>{item.name}</h3><p>{item.text}</p></article>)}
      </div>
      <div class="definition-list one-column">
        {weaponProperties.map((item) => <article><h3>{item.name}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section id="lista" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Consulta</p><h2>Lista de Armas</h2></div></div>

    <section class="filter-panel equipment-filter-panel">
      <label class="search-field">
        <span>Buscar arma ou propriedade</span>
        <input id="weapon-search" type="search" placeholder="Ex.: espada, arremesso, haste..." autocomplete="off" />
      </label>
      <label class="select-field">
        <span>Categoria</span>
        <select id="weapon-category">
          <option value="all">Todas</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label class="select-field">
        <span>Tipo de dano</span>
        <select id="weapon-type">
          <option value="all">Todos</option>
          <option value="Corte">Corte</option>
          <option value="Perfuração">Perfuração</option>
          <option value="Esmagamento">Esmagamento</option>
        </select>
      </label>
      <p class="results-count"><strong id="weapon-count">{weapons.length}</strong> armas exibidas</p>
    </section>

    <div class="table-wrap weapon-table-wrap">
      <table class="rules-table equipment-list-table">
        <thead><tr><th>Arma</th><th>Categoria</th><th>Preço</th><th>Dano</th><th>Crítico</th><th>Propriedades</th><th>Peso</th><th>Tipo</th></tr></thead>
        <tbody id="weapon-body">
          {weapons.map((weapon) => (
            <tr
              class="weapon-row"
              data-search={[weapon.name,weapon.properties,weapon.type].join(' ').toLowerCase()}
              data-category={weapon.category}
              data-type={weapon.type}
            >
              <td><strong>{weapon.name}</strong></td><td>{weapon.category}</td><td>{weapon.price}</td><td>{weapon.damage}</td><td>{weapon.critical}</td><td>{weapon.properties}</td><td>{weapon.weight}</td><td>{weapon.type}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="empty-state" id="weapon-empty" hidden>Nenhuma arma corresponde aos filtros atuais.</p>
  </section>

  <section id="municoes" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Pacotes de 10</p><h2>Munições</h2></div></div>
    <div class="table-wrap">
      <table class="rules-table">
        <thead><tr><th>Munição</th><th>Preço</th><th>Dano</th><th>Crítico</th><th>Propriedades</th><th>Tipo</th></tr></thead>
        <tbody>{ammunition.map((item) => <tr><td>{item.name}</td><td>{item.price}</td><td>{item.damage}</td><td>{item.critical}</td><td>{item.properties}</td><td>{item.type}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="tamanho" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Escala de dano</p><h2>Tamanho das Armas</h2></div></div>
    <div class="combat-prose">{weaponSizeRules.map((p) => <p>{p}</p>)}</div>
    <div class="table-wrap">
      <table class="rules-table size-table">
        <thead><tr>{weaponSizeTable.headers.map((h) => <th>{h}</th>)}</tr></thead>
        <tbody>{weaponSizeTable.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
      </table>
    </div>
  </section>

  <section id="tecnologicas" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Conteúdo especial</p><h2>Armas Tecnológicas</h2></div></div>
    <div class="notice tech-warning">{technologicalWarning}</div>
    <div class="table-wrap">
      <table class="rules-table equipment-list-table">
        <thead><tr><th>Arma</th><th>Grupo</th><th>Preço</th><th>Dano</th><th>Crítico</th><th>Distância</th><th>Peso</th><th>Tipo</th></tr></thead>
        <tbody>{technologicalWeapons.map((weapon) => <tr><td>{weapon.name}</td><td>{weapon.category}</td><td>{weapon.price}</td><td>{weapon.damage}</td><td>{weapon.critical}</td><td>{weapon.range}</td><td>{weapon.weight}</td><td>{weapon.type}</td></tr>)}</tbody>
      </table>
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('weapon-search');
      const category = document.getElementById('weapon-category');
      const type = document.getElementById('weapon-type');
      const rows = [...document.querySelectorAll('.weapon-row')];
      const count = document.getElementById('weapon-count');
      const empty = document.getElementById('weapon-empty');
      const normalize = (v) => v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();

      const apply = () => {
        const q = normalize(input.value.trim());
        let visible = 0;
        rows.forEach((row) => {
          const matchesText = !q || normalize(row.dataset.search || '').includes(q);
          const matchesCategory = category.value === 'all' || row.dataset.category === category.value;
          const matchesType = type.value === 'all' || (row.dataset.type || '').includes(type.value);
          const show = matchesText && matchesCategory && matchesType;
          row.hidden = !show;
          if (show) visible++;
        });
        count.textContent = String(visible);
        empty.hidden = visible !== 0;
      };
      input.addEventListener('input',apply);
      category.addEventListener('change',apply);
      type.addEventListener('change',apply);
    })();
  </script>
</BaseLayout>
