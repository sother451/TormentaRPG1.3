---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classEntries, type ClassEntry } from '../../data/classes';

export function getStaticPaths() {
  return classEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

interface Props { entry: ClassEntry; }
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---
<BaseLayout title={entry.name} activePath="/classes/">
  <div class="breadcrumbs"><a href={href('/classes/')}>Classes</a> / {entry.family} / {entry.name}</div>

  <section class="section-hero">
    <div class="class-head">
      <div>
        <p class="eyebrow">{entry.family}</p>
        <h1>{entry.name}</h1>
      </div>
      <span class:list={['status-badge', entry.status && entry.status !== 'mapeada' && 'warn']}>
        {entry.status === 'fonte-incompleta' ? 'Fonte incompleta' : entry.status === 'revisar' ? 'Revisão pendente' : 'Mapeada'}
      </span>
    </div>
    {entry.note && <div class="notice">{entry.note}</div>}
  </section>

  <section class="info-grid" aria-label="Resumo da classe">
    <article class="info-card"><span>PV iniciais</span><strong>{entry.pvInitial} + Con</strong><p>+{entry.pvPerLevel} + Con por nível seguinte.</p></article>
    <article class="info-card"><span>BBA</span><strong>{entry.bba}</strong><p>Progressão de bônus base de ataque.</p></article>
    <article class="info-card"><span>Sistemas próprios</span><strong>{entry.systems.length}</strong><p>{entry.systems.join(', ')}.</p></article>
  </section>

  <div class="section-heading"><div><p class="eyebrow">Estrutura da página</p><h2>Habilidades e progressão</h2></div></div>
  <div class="notice">A tabela de níveis e o texto das habilidades serão importados diretamente da fonte Tormenta 1.3. Sistemas exclusivos como Golpes, Posturas, Formas, Músicas e Truques permanecem dentro desta página.</div>

  <div class="section-heading"><div><p class="eyebrow">Exclusivos da classe</p><h2>Talentos de {entry.name}</h2></div></div>
  <div class="definition-list">
    <article><h3>Organização</h3><p>Os talentos desta classe serão divididos pelas faixas de 4º, 8º, 12º, 16º e 20º nível.</p></article>
    <article><h3>Regra do compêndio</h3><p>Talentos de classe ficam somente aqui. A biblioteca geral de Talentos não mistura opções exclusivas de classe.</p></article>
  </div>
</BaseLayout>
