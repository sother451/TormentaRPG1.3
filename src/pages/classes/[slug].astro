---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classEntries, type ClassEntry } from '../../data/classes';
import { classDetails, type ClassDetail } from '../../data/class-details/index';
import '../../styles/classes.css';

export function getStaticPaths() {
  return classDetails.map((detail) => ({
    params: { slug: detail.slug },
    props: {
      detail,
      entry: classEntries.find((item) => item.slug === detail.slug)
    }
  }));
}

interface Props {
  detail: ClassDetail;
  entry?: ClassEntry;
}

const { detail, entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const headerLabel = (header: string, index: number) => header || (index === 2 ? 'Habilidades' : '—');
const talentLevels = [4, 8, 12, 16, 20];
const orphanTalents = detail.classTalents.filter((talent) => !talent.prerequisiteLevel || !talentLevels.includes(talent.prerequisiteLevel));
---
<BaseLayout title={detail.name} activePath="/classes/">
  <div class="breadcrumbs"><a href={href('/classes/')}>Classes</a> / {detail.family} / {detail.name}</div>

  <section class="section-hero class-detail-hero">
    <div class="class-head">
      <div>
        <p class="eyebrow">{detail.family}</p>
        <h1>{detail.name}</h1>
        <p class="class-source-title">Fonte: {detail.sourceTitle}</p>
      </div>
      <span class:list={['status-badge', detail.status !== 'complete' && 'warn']}>
        {detail.status === 'incomplete_source' ? 'Fonte incompleta' : detail.status === 'wip' ? 'WIP' : 'Convertida'}
      </span>
    </div>

    {detail.editorialNotes.map((note) => <div class="notice">{note}</div>)}
  </section>

  <nav class="local-nav class-local-nav" aria-label="Nesta página">
    <a href="#visao-geral">Visão Geral</a>
    <a href="#progressao">Progressão</a>
    <a href="#habilidades">Habilidades e Sistemas</a>
    {detail.classTalents.length > 0 && <a href="#talentos">Talentos de Classe</a>}
  </nav>

  <section id="visao-geral" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Classe</p><h2>Visão Geral</h2></div></div>

    {detail.kind === 'prestige' ? (
      <>
        <div class="class-basics-grid prestige-basics">
          <article>
            <span>Pontos de Vida</span>
            <p>{detail.basics.hitPoints ?? 'Não indicado na fonte.'}</p>
          </article>
          <article>
            <span>Requisitos</span>
            {detail.requirements && detail.requirements.length > 0
              ? detail.requirements.map((requirement) => <p>{requirement}</p>)
              : <p>Não indicados na fonte.</p>}
          </article>
        </div>
      </>
    ) : (
      <>
        <div class="class-basics-grid">
          <article>
            <span>Pontos de Vida</span>
            <p>{detail.basics.hitPoints ?? 'Não indicado na fonte.'}</p>
          </article>
          <article>
            <span>Perícias Treinadas</span>
            <p>{detail.basics.trainedSkills ?? 'Não indicado na fonte.'}</p>
          </article>
          <article>
            <span>Perícias de Classe</span>
            <p>{detail.basics.classSkills ?? 'Não indicado na fonte.'}</p>
          </article>
          <article>
            <span>Talentos Adicionais</span>
            <p>{detail.basics.bonusTalents ?? 'Não indicado na fonte.'}</p>
          </article>
        </div>

        {entry && (
          <div class="class-quick-facts">
            <span><strong>BBA:</strong> {entry.bba}</span>
            <span><strong>Sistemas mapeados:</strong> {entry.systems.join(' · ')}</span>
          </div>
        )}
      </>
    )}
  </section>

  <section id="progressao" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">{detail.kind === 'prestige' ? 'Níveis 1–10' : 'Níveis 1–20'}</p><h2>Progressão</h2></div></div>
    <div class="table-wrap class-progression-wrap">
      <table class="rules-table class-progression-table">
        <thead>
          <tr>{detail.progression.headers.map((header, index) => <th>{headerLabel(header, index)}</th>)}</tr>
        </thead>
        <tbody>
          {detail.progression.rows.map((row) => (
            <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="habilidades" class="rule-section">
    <div class="section-heading"><div><p class="eyebrow">Conteúdo da classe</p><h2>Habilidades e Sistemas</h2></div></div>

    <div class="class-sections">
      {detail.sections.map((section, index) => (
        section.level === 1 ? (
          <div class="class-system-divider" id={section.title ? section.title.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'') : undefined}>
            {section.title && <h3>{section.title}</h3>}
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.tables.map((table) => (
              <div class="table-wrap class-inline-table">
                <table class="rules-table">
                  <thead><tr>{table.headers.map((header) => <th>{header}</th>)}</tr></thead>
                  <tbody>{table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                </table>
              </div>
            ))}
          </div>
        ) : (
          <article class="class-feature-card">
            {section.title && <h3>{section.title}</h3>}
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {section.tables.map((table) => (
              <div class="table-wrap class-inline-table">
                <table class="rules-table">
                  <thead><tr>{table.headers.map((header) => <th>{header}</th>)}</tr></thead>
                  <tbody>{table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                </table>
              </div>
            ))}
          </article>
        )
      ))}
    </div>
  </section>

  {detail.classTalents.length > 0 && (
  <section id="talentos" class="rule-section">
    <div class="section-heading">
      <div><p class="eyebrow">Exclusivos</p><h2>Talentos de {detail.name}</h2></div>
      <span class="section-count">{detail.classTalents.length} talentos</span>
    </div>

    <div class="notice">Estes talentos pertencem à própria classe. Eles não são misturados com a biblioteca de Talentos Gerais do compêndio.</div>

    {talentLevels.map((level) => {
      const talents = detail.classTalents.filter((talent) => talent.prerequisiteLevel === level);
      if (talents.length === 0) return null;
      return (
        <section class="class-talent-level">
          <h3>{level}º nível</h3>
          <div class="class-talent-grid">
            {talents.map((talent) => (
              <article class="class-talent-card" id={talent.id}>
                <header>
                  <h4>{talent.name}</h4>
                  {talent.prerequisite && <span>{talent.prerequisite}</span>}
                </header>
                {talent.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </article>
            ))}
          </div>
        </section>
      );
    })}

    {orphanTalents.length > 0 && (
      <section class="class-talent-level">
        <h3>Outros pré-requisitos</h3>
        <div class="class-talent-grid">
          {orphanTalents.map((talent) => (
            <article class="class-talent-card" id={talent.id}>
              <header><h4>{talent.name}</h4>{talent.prerequisite && <span>{talent.prerequisite}</span>}</header>
              {talent.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </article>
          ))}
        </div>
      </section>
    )}
  </section>
  )}
</BaseLayout>
