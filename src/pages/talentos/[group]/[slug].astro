---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { talents, talentGroups, type TalentEntry } from '../../../../data/talentos';
import '../../../../styles/talents.css';

export function getStaticPaths() {
  return talents.map((talent) => ({
    params: {
      group: talent.groupSlug,
      slug: talent.id.replace(`${talent.groupSlug}-`, '')
    },
    props: { talent }
  }));
}

interface Props { talent: TalentEntry; }
const { talent } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const group = talentGroups.find((item) => item.slug === talent.groupSlug);
---
<BaseLayout title={talent.name} activePath="/talentos/">
  <div class="breadcrumbs">
    <a href={href('/talentos/')}>Talentos</a> / {talent.group} / {talent.name}
  </div>

  <section class="section-hero talent-detail-hero">
    <p class="eyebrow">{talent.group}</p>
    <h1>{talent.name}</h1>

    <div class="talent-detail-meta">
      {talent.prerequisites.length > 0 && (
        <article>
          <span>Pré-requisito</span>
          {talent.prerequisites.map((item) => <strong>{item}</strong>)}
        </article>
      )}
      {talent.costs.length > 0 && (
        <article>
          <span>Custo</span>
          {talent.costs.map((item) => <strong>{item}</strong>)}
        </article>
      )}
      <article>
        <span>Grupo</span>
        <strong>{talent.group}</strong>
      </article>
    </div>
  </section>

  <section class="rule-section">
    <div class="section-heading">
      <div><p class="eyebrow">Descrição</p><h2>Efeito</h2></div>
    </div>

    <div class="talent-body">
      {talent.blocks.length > 0 ? talent.blocks.map((block) => (
        block.kind === 'subheading'
          ? <h3>{block.text}</h3>
          : <p>{block.text}</p>
      )) : <div class="notice">A fonte não apresenta texto adicional para este talento.</div>}
    </div>
  </section>

  <section class="talent-detail-footer">
    <a href={href('/talentos/')}>← Voltar para todos os talentos</a>
    {group && <span>{group.count} talentos em {group.name}</span>}
  </section>
</BaseLayout>
