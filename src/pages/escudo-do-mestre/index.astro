---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RuleText from '../../components/RuleText.astro';
import { combat } from '../../data/combate';
import { generalSkillRules, skills } from '../../data/pericias';
import { actionPoints, conditions } from '../../data/condicoes';
import '../../styles/gm-screen.css';

const actionGroups = [
  { title: 'Ações padrão', blocks: combat.standardActions },
  { title: 'Ações de movimento', blocks: combat.moveActions },
  { title: 'Ações completas', blocks: combat.fullActions },
  { title: 'Ações livres', blocks: combat.freeActions },
  { title: 'Reações', blocks: combat.reactions }
];


const skillSearchText = (skill: (typeof skills)[number]) => [
  skill.name,
  skill.ability ?? '',
  skill.trainedOnly ? 'treinada' : '',
  skill.armorPenalty ? 'armadura penalidade' : '',
  ...skill.blocks.flatMap((block) => [
    block.title ?? '',
    ...block.paragraphs,
    ...(block.table?.headers ?? []),
    ...(block.table?.rows.flat() ?? [])
  ])
].join(' ').toLowerCase();

const combatSearchText = [
  ...combat.actionTypes,
  ...combat.standardActions.flatMap((block) => [block.title ?? '', ...block.paragraphs]),
  ...combat.moveActions.flatMap((block) => [block.title ?? '', ...block.paragraphs]),
  ...combat.fullActions.flatMap((block) => [block.title ?? '', ...block.paragraphs]),
  ...combat.freeActions.flatMap((block) => [block.title ?? '', ...block.paragraphs]),
  ...combat.reactions.flatMap((block) => [block.title ?? '', ...block.paragraphs]),
  ...combat.attackerTable.headers,
  ...combat.attackerTable.rows.flat(),
  ...combat.targetTable.headers,
  ...combat.targetTable.rows.flat()
].join(' ').toLowerCase();
---
<BaseLayout title="Escudo do Mestre" activePath="/escudo-do-mestre/">
  <section class="section-hero gm-hero">
    <p class="eyebrow">Referência rápida · Tormenta RPG 1.3</p>
    <h1>Escudo do Mestre</h1>
    <p class="lede">Uma tela autocontida para consulta durante a sessão. O conteúdo abaixo usa apenas regras já consolidadas no Tormenta 1.3 e não redireciona para outras páginas.</p>
    <div class="notice">
      Primeira versão: Combate, Perícias, Condições e Pontos de Ação. Exploração, objetos e experiência serão adicionados somente depois de auditados na fonte 1.3.
    </div>
  </section>

  <section class="gm-toolbar" aria-label="Ferramentas do Escudo do Mestre">
    <label class="search-field gm-search">
      <span>Busca global no escudo</span>
      <input id="gm-search" type="search" placeholder="Ex.: agarrado, furtividade, ataque, ponto de ação..." autocomplete="off" />
    </label>
    <p class="results-count"><strong id="gm-result-count">0</strong> referências encontradas</p>
  </section>

  <nav class="gm-tabs" aria-label="Seções do Escudo do Mestre">
    <button type="button" class="gm-tab is-active" data-gm-tab="overview">Visão geral</button>
    <button type="button" class="gm-tab" data-gm-tab="combat">Combate</button>
    <button type="button" class="gm-tab" data-gm-tab="skills">Perícias</button>
    <button type="button" class="gm-tab" data-gm-tab="conditions">Condições</button>
    <button type="button" class="gm-tab" data-gm-tab="action-points">Pontos de Ação</button>
  </nav>

  <section class="gm-panel" data-shield-panel="overview">
    <div class="section-heading">
      <div><p class="eyebrow">Mesa em andamento</p><h2>Consulta imediata</h2></div>
    </div>

    <div class="gm-overview-grid">
      <article class="gm-tool-card" data-shield-item data-search="calculadora dano dados dado média mínimo máximo bonus fixo">
        <h3>Calculadora de dano</h3>
        <p>Informe os dados de dano e o bônus fixo para consultar rapidamente os valores <strong>mínimo, médio e máximo</strong>.</p>
        <div class="gm-calculator-grid gm-damage-inputs">
          <label>
            <span>Quantidade de dados</span>
            <input id="gm-dice-count" type="number" min="1" max="100" value="1" inputmode="numeric" />
          </label>
          <label>
            <span>Faces do dado</span>
            <select id="gm-die-faces">
              <option value="4">d4</option>
              <option value="6" selected>d6</option>
              <option value="8">d8</option>
              <option value="10">d10</option>
              <option value="12">d12</option>
              <option value="20">d20</option>
              <option value="100">d100</option>
            </select>
          </label>
          <label>
            <span>Bônus fixo</span>
            <input id="gm-damage-bonus" type="number" min="-999" max="999" value="0" inputmode="numeric" />
          </label>
        </div>
        <p class="gm-damage-expression">Expressão: <strong id="gm-damage-expression">1d6</strong></p>
        <div class="gm-result-box gm-damage-results" aria-live="polite">
          <span>Mínimo <strong id="gm-damage-min">1</strong></span>
          <span>Médio <strong id="gm-damage-average">3,5</strong></span>
          <span>Máximo <strong id="gm-damage-max">6</strong></span>
        </div>
      </article>

      <article class="gm-tool-card" data-shield-item data-search="ponto ação recuperação pv pm dado extra nível tabela">
        <h3>Ponto de Ação por nível</h3>
        <p>Referência direta do Tormenta 1.3 para dado extra e recuperação por faixa de nível.</p>
        <div class="table-wrap gm-ap-overview-table">
          <table class="rules-table">
            <thead><tr>{actionPoints.recoveryTable.headers.map((header) => <th>{header}</th>)}</tr></thead>
            <tbody>{actionPoints.recoveryTable.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </article>

      <article class="gm-tool-card gm-turn-card" data-shield-item data-search="turno rodada ação padrão movimento completa livre reação">
        <h3>No seu turno</h3>
        <div class="gm-compact-list">
          {combat.actionTypes.slice(0, 4).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <article class="gm-tool-card" data-shield-item data-search="condições quantidade lista vinte quatro 24">
        <h3>Condições</h3>
        <p><strong>{conditions.length}</strong> condições do Tormenta 1.3 disponíveis neste escudo, todas com o efeito descrito no próprio painel.</p>
      </article>
    </div>
  </section>

  <section class="gm-panel" data-shield-panel="combat" hidden>
    <div class="section-heading">
      <div><p class="eyebrow">Rodada e modificadores</p><h2>Combate</h2></div>
    </div>

    <article class="gm-reference-block" data-shield-item data-search={combatSearchText}>
      <h3>Economia de ações</h3>
      <div class="gm-rule-prose">
        {combat.actionTypes.map((paragraph) => <RuleText text={paragraph} />)}
      </div>
    </article>

    <div class="gm-table-grid">
      <article class="gm-reference-block" data-shield-item data-search={combat.attackerTable.rows.flat().join(' ').toLowerCase()}>
        <h3>Modificadores do atacante</h3>
        <div class="table-wrap">
          <table class="rules-table">
            <thead><tr>{combat.attackerTable.headers.map((header) => <th>{header}</th>)}</tr></thead>
            <tbody>{combat.attackerTable.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </article>

      <article class="gm-reference-block" data-shield-item data-search={combat.targetTable.rows.flat().join(' ').toLowerCase()}>
        <h3>Modificadores do defensor</h3>
        <div class="table-wrap">
          <table class="rules-table">
            <thead><tr>{combat.targetTable.headers.map((header) => <th>{header}</th>)}</tr></thead>
            <tbody>{combat.targetTable.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
          </table>
        </div>
      </article>
    </div>

    <div class="gm-action-groups">
      {actionGroups.map((group) => (
        <article
          class="gm-reference-block"
          data-shield-item
          data-search={[group.title, ...group.blocks.flatMap((block) => [block.title ?? '', ...block.paragraphs])].join(' ').toLowerCase()}
        >
          <h3>{group.title}</h3>
          <div class="gm-inline-rule-list">
            {group.blocks.map((block) => (
              <section class="gm-inline-rule">
                {block.title && <h4>{block.title}</h4>}
                {block.paragraphs.map((paragraph) => <RuleText text={paragraph} />)}
              </section>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="gm-panel" data-shield-panel="skills" hidden>
    <div class="section-heading">
      <div><p class="eyebrow">CDs, usos e testes</p><h2>Perícias</h2></div>
    </div>

    <div class="gm-general-rules">
      {generalSkillRules.map((rule) => (
        <article
          class="gm-reference-block gm-compact-rule-card"
          data-shield-item
          data-search={[rule.title, ...rule.paragraphs].join(' ').toLowerCase()}
        >
          <h3>{rule.title}</h3>
          <div class="gm-rule-prose">
            {rule.paragraphs.map((paragraph) => <RuleText text={paragraph} />)}
          </div>
        </article>
      ))}
    </div>

    <div class="gm-skill-grid">
      {skills.map((skill) => (
        <article
          class="gm-skill-card"
          data-shield-item
          data-search={skillSearchText(skill)}
        >
          <header class="gm-skill-head">
            <strong>{skill.name}</strong>
            <small>{skill.ability ?? 'Habilidade não indicada'}{skill.trainedOnly ? ' · Treinada' : ''}{skill.armorPenalty ? ' · Armadura' : ''}</small>
          </header>
          <div class="gm-details-body">
            {skill.blocks.map((block) => (
              <section class="gm-skill-block">
                {block.title && <h4>{block.title}</h4>}
                {block.paragraphs.map((paragraph) => <RuleText text={paragraph} />)}
                {block.table && (
                  <div class="table-wrap">
                    <table class="rules-table">
                      <thead><tr>{block.table.headers.map((header) => <th>{header}</th>)}</tr></thead>
                      <tbody>{block.table.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                )}
              </section>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="gm-panel" data-shield-panel="conditions" hidden>
    <div class="section-heading">
      <div><p class="eyebrow">Estados prejudiciais</p><h2>Condições</h2></div>
    </div>
    <div class="gm-condition-grid">
      {conditions.map((condition) => (
        <article
          class="gm-condition-card"
          data-shield-item
          data-search={[condition.name, condition.description].join(' ').toLowerCase()}
        >
          <h3>{condition.name}</h3>
          <p>{condition.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="gm-panel" data-shield-panel="action-points" hidden>
    <div class="section-heading">
      <div><p class="eyebrow">Recurso heroico</p><h2>Pontos de Ação</h2></div>
    </div>

    <div class="gm-table-grid">
      <article class="gm-reference-block" data-shield-item data-search={actionPoints.gaining.join(' ').toLowerCase()}>
        <h3>Ganhando Pontos de Ação</h3>
        <div class="gm-rule-prose">
          {actionPoints.gaining.map((paragraph) => <RuleText text={paragraph} />)}
        </div>
      </article>

      <article class="gm-reference-block" data-shield-item data-search={actionPoints.using.join(' ').toLowerCase()}>
        <h3>Usando Pontos de Ação</h3>
        <div class="gm-rule-prose">
          {actionPoints.using.map((paragraph) => <RuleText text={paragraph} />)}
        </div>
      </article>
    </div>

  </section>

  <p class="empty-state gm-empty" id="gm-empty" hidden>Nenhuma referência do escudo corresponde à busca atual.</p>

  <script is:inline>
    (() => {
      const search = document.getElementById('gm-search');
      const count = document.getElementById('gm-result-count');
      const empty = document.getElementById('gm-empty');
      const tabs = [...document.querySelectorAll('[data-gm-tab]')];
      const panels = [...document.querySelectorAll('[data-shield-panel]')];
      const items = [...document.querySelectorAll('[data-shield-item]')];
      let activeTab = 'overview';

      const normalize = (value) => String(value || '')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase();

      const showActiveTab = () => {
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.shieldPanel !== activeTab;
        });
        tabs.forEach((tab) => tab.classList.toggle('is-active', tab.dataset.gmTab === activeTab));
        count.textContent = '0';
        empty.hidden = true;
        items.forEach((item) => item.hidden = false);
      };

      const applySearch = () => {
        const query = normalize(search.value.trim());
        if (!query) {
          showActiveTab();
          return;
        }

        let visible = 0;
        panels.forEach((panel) => panel.hidden = false);

        items.forEach((item) => {
          const match = normalize(item.dataset.search).includes(query);
          item.hidden = !match;
          if (match) visible += 1;
        });

        panels.forEach((panel) => {
          const hasVisible = [...panel.querySelectorAll('[data-shield-item]')].some((item) => !item.hidden);
          panel.hidden = !hasVisible;
        });

        count.textContent = String(visible);
        empty.hidden = visible !== 0;
      };

      tabs.forEach((tab) => tab.addEventListener('click', () => {
        activeTab = tab.dataset.gmTab;
        search.value = '';
        showActiveTab();
      }));

      search.addEventListener('input', applySearch);
      showActiveTab();

      const diceCountInput = document.getElementById('gm-dice-count');
      const dieFacesInput = document.getElementById('gm-die-faces');
      const damageBonusInput = document.getElementById('gm-damage-bonus');
      const damageExpression = document.getElementById('gm-damage-expression');
      const damageMin = document.getElementById('gm-damage-min');
      const damageAverage = document.getElementById('gm-damage-average');
      const damageMax = document.getElementById('gm-damage-max');

      const formatNumber = (value) => new Intl.NumberFormat('pt-BR', {
        maximumFractionDigits: 2
      }).format(value);

      const updateDamageCalculator = () => {
        const diceCount = Math.max(1, Math.min(100, Math.trunc(Number(diceCountInput.value) || 1)));
        const dieFaces = Math.max(2, Number(dieFacesInput.value) || 6);
        const bonus = Math.max(-999, Math.min(999, Math.trunc(Number(damageBonusInput.value) || 0)));

        const minimum = diceCount + bonus;
        const average = diceCount * ((dieFaces + 1) / 2) + bonus;
        const maximum = diceCount * dieFaces + bonus;

        const bonusText = bonus > 0 ? `+${bonus}` : bonus < 0 ? String(bonus) : '';
        damageExpression.textContent = `${diceCount}d${dieFaces}${bonusText}`;
        damageMin.textContent = formatNumber(minimum);
        damageAverage.textContent = formatNumber(average);
        damageMax.textContent = formatNumber(maximum);
      };

      diceCountInput.addEventListener('input', updateDamageCalculator);
      dieFacesInput.addEventListener('change', updateDamageCalculator);
      damageBonusInput.addEventListener('input', updateDamageCalculator);
      updateDamageCalculator();
    })();
  </script>
</BaseLayout>
